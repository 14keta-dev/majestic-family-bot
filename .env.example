# Bot Token
# https://discord.com/developers/applications/{applicationsID}/bot -> Token -> Reset -> Copy
DISCORD_BOT_TOKEN=

# Bot client ID
# https://discord.com/developers/applications -> Your application -> Application ID -> Copy
DISCORD_BOT_CLIENT=

# ID that webhook will be pinging when encounter error
# Profile -> Right Click -> Copy ID
DEVELOPER_ID=

# prefix command
# default !
PREFIX="!"

# Guild where bot will be operating
# You can only deploy main command to selected guild
# Guild -> Right Click -> Copy Guild ID
DISCORD_GUILD=

# Supabase Postgres connection string (pooled via Supavisor)
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Copy
#
# Mode: SESSION pooling (port 5432 on the *.pooler.supabase.com host)
#   - Supports prepared statements / session-level features — safe default for
#     a long-lived Node process (e.g. this bot) holding a persistent pool.
#   - For transaction pooling instead (higher connection churn, e.g. serverless/
#     edge functions), use port 6543 on the same pooler host and make sure
#     your ORM/driver disables prepared statements.
#
# Format: postgresql://<user>.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Discord webhook URL that unhandled/logged errors get sent to (see safeReply.helper)
# Channel Settings -> Integrations -> Webhooks -> New/Copy Webhook URL
WEBHOOK_URL=


#Status of bot
# production minimal logs some functions are stripepd to not nuke server
# Development detailed logging with all function avaliable 
NODE_ENV= "development" | "production"